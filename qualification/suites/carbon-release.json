{
  "schema_version": 1,
  "name": "carbon-production-readiness",
  "description": "Blocking installed-build qualification for Carbon's CLI, Studio plugin, and auto-recovery capture path.",
  "variables": {
    "repo": "${suite_dir}/../..",
    "carbon": "carbon",
    "port": "48125",
    "build_output": "${artifact_dir}/qualification.rbxl",
    "capture_rebuild_output": "${artifact_dir}/capture-rebuilt.rbxl"
  },
  "requirements": {
    "operating_systems": ["windows", "linux"],
    "variables": ["carbon", "project", "data_dir", "port", "studio_data_model", "studio_launch_path"]
  },
  "policy": {
    "fail_on_command_warnings": true,
    "fail_on_runtime_warnings": true,
    "minimum_scenarios": 3,
    "required_tags": [
      "preflight",
      "determinism",
      "runtime",
      "lifecycle",
      "capture",
      "crash_safety"
    ],
    "max_suite_seconds": 1200
  },
  "scenarios": [
    {
      "name": "candidate-cli-preflight",
      "description": "Proves the exact installed candidate can start cleanly.",
      "tags": ["preflight"],
      "steps": [
        {
          "name": "candidate-version",
          "kind": "command",
          "program": "${carbon}",
          "args": ["--color", "never", "--version"],
          "cwd": "${repo}",
          "timeout_seconds": 30,
          "stdout_contains": ["carbon"]
        }
      ]
    },
    {
      "name": "deterministic-installed-build",
      "description": "Builds twice and requires stable artifact and manifest bytes.",
      "tags": ["determinism", "preflight"],
      "steps": [
        {
          "name": "first-build",
          "kind": "command",
          "program": "${carbon}",
          "args": ["build", "${project}", "--output", "${build_output}", "--color", "never"],
          "cwd": "${repo}",
          "timeout_seconds": 300
        },
        {
          "name": "snapshot-built-place",
          "kind": "snapshot_path",
          "snapshot": "built-place",
          "path": "${build_output}"
        },
        {
          "name": "snapshot-data-directory",
          "kind": "snapshot_path",
          "snapshot": "data-after-first-build",
          "path": "${data_dir}"
        },
        {
          "name": "second-build",
          "kind": "command",
          "program": "${carbon}",
          "args": ["build", "${project}", "--output", "${build_output}", "--color", "never"],
          "cwd": "${repo}",
          "timeout_seconds": 300
        },
        {
          "name": "stable-build-bytes",
          "kind": "assert_path_unchanged",
          "snapshot": "built-place",
          "path": "${build_output}",
          "check_mtime": false
        },
        {
          "name": "stable-manifest-bytes-and-mtimes",
          "kind": "assert_path_unchanged",
          "snapshot": "data-after-first-build",
          "path": "${data_dir}",
          "check_mtime": true
        },
        {
          "name": "build-offline-capture-input",
          "kind": "command",
          "program": "${carbon}",
          "args": ["build", "${project}", "--output", "${studio_launch_path}", "--worktree-endpoint", "http://127.0.0.1:1", "--worktree-project", "${studio_data_model}", "--worktree-id", "qualification-offline", "--session-token", "qualification-offline", "--color", "never"],
          "cwd": "${repo}",
          "timeout_seconds": 300
        },
        {
          "name": "capture-offline-binary-place",
          "kind": "command",
          "program": "${carbon}",
          "args": ["capture", "${project}", "${studio_launch_path}", "--color", "never"],
          "cwd": "${repo}",
          "timeout_seconds": 300,
          "stderr_contains": ["Capture Manifest committed project generation"]
        }
      ]
    },
    {
      "name": "managed-studio-auto-recovery-capture",
      "description": "Launches Studio normally, authors an edit, waits for a new auto-recovery save, commits it, and rebuilds the captured project.",
      "tags": ["runtime", "lifecycle", "capture", "crash_safety", "determinism"],
      "steps": [
        {
          "name": "start-managed-serve",
          "kind": "spawn",
          "process": "carbon-serve",
          "program": "${carbon}",
          "args": ["serve", "${project}", "--port", "${port}", "--yes", "--color", "never"],
          "cwd": "${repo}",
          "env": {
            "CARBON_QUALIFICATION_STUDIO_NAME": "${studio_data_model}"
          }
        },
        {
          "name": "wait-for-studio-connection",
          "kind": "mcp",
          "tool": "get_connected_instances",
          "arguments": {},
          "timeout_seconds": 120,
          "poll_interval_ms": 100,
          "select": {
            "pointer": "/instances",
            "checks": [
              {"pointer": "/dataModelName", "op": "equals", "value": "${studio_data_model}"},
              {"pointer": "/role", "op": "equals", "value": "edit"},
              {"pointer": "/versionMismatch", "op": "equals", "value": false}
            ]
          },
          "capture": {
            "studio_instance": "/instanceId"
          }
        },
        {
          "name": "focus-managed-studio",
          "kind": "command",
          "program": "${carbon}",
          "args": ["focus", "--port", "${port}", "--color", "never"],
          "cwd": "${repo}",
          "timeout_seconds": 30,
          "stderr_contains": ["Focused Roblox Studio PID"]
        },
        {
          "name": "author-studio-change",
          "kind": "mcp",
          "tool": "execute_luau",
          "arguments": {
            "instance_id": "${studio_instance}",
            "target": "edit",
            "code": "local old = workspace:FindFirstChild('CarbonAutoRecoveryProbe'); if old then old:Destroy() end; local probe = Instance.new('Part'); probe.Name = 'CarbonAutoRecoveryProbe'; probe.Anchored = true; probe.Size = Vector3.new(7, 3, 5); probe:SetAttribute('CapturedThroughAutoRecovery', true); probe.Parent = workspace; return probe:GetFullName()"
          },
          "timeout_seconds": 30,
          "max_duration_ms": 2000
        },
        {
          "name": "stop-after-next-auto-recovery",
          "kind": "command",
          "program": "${carbon}",
          "args": ["stop", "${studio_instance}", "--color", "never"],
          "cwd": "${repo}",
          "timeout_seconds": 390,
          "stderr_contains": ["auto-recovery"]
        },
        {
          "name": "wait-for-managed-serve-shutdown",
          "kind": "wait_process",
          "process": "carbon-serve",
          "timeout_seconds": 30,
          "expected_exit_codes": [0]
        },
        {
          "name": "rebuild-recovered-capture",
          "kind": "command",
          "program": "${carbon}",
          "args": ["build", "${project}", "--output", "${capture_rebuild_output}", "--color", "never"],
          "cwd": "${repo}",
          "timeout_seconds": 300
        },
        {
          "name": "verify-rebuilt-place-contains-live-edit",
          "kind": "command",
          "program": "${carbon}",
          "args": ["diff", "${build_output}", "${capture_rebuild_output}", "--json", "--no-fail", "--color", "never"],
          "cwd": "${repo}",
          "timeout_seconds": 300,
          "stdout_contains": ["CarbonAutoRecoveryProbe"]
		},
		{
		  "name": "verify-rebuilt-capture-state",
		  "kind": "assert_place_instance",
		  "path": "${capture_rebuild_output}",
		  "instance_path": ["Workspace", "CarbonAutoRecoveryProbe"],
		  "class": "Part",
		  "properties": {
		    "Anchored": true,
		    "Size": [7, 3, 5]
		  },
		  "attributes": {
		    "CapturedThroughAutoRecovery": true
		  }
		}
      ]
    }
  ]
}
