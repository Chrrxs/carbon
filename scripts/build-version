#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=scripts/lib/release-version.sh
. "${SCRIPT_DIR}/lib/release-version.sh"

if [[ -n "${CARBON_BUILD_VERSION:-}" ]]; then
	release_version_from_build "$CARBON_BUILD_VERSION" >/dev/null || {
		echo "invalid CARBON_BUILD_VERSION: $CARBON_BUILD_VERSION" >&2
		exit 2
	}
	printf '%s\n' "$CARBON_BUILD_VERSION"
	exit 0
fi

timestamp="${CARBON_BUILD_TIMESTAMP:-}"
if [[ -z "$timestamp" ]]; then
	if [[ -n "${SOURCE_DATE_EPOCH:-}" ]]; then
		[[ "$SOURCE_DATE_EPOCH" =~ ^[0-9]+$ ]] || {
			echo "invalid SOURCE_DATE_EPOCH: $SOURCE_DATE_EPOCH" >&2
			exit 2
		}
		timestamp="$(TZ=America/New_York date -d "@${SOURCE_DATE_EPOCH}" '+%Y-%m-%dT%H:%M')"
	else
		timestamp="$(TZ=America/New_York date '+%Y-%m-%dT%H:%M')"
	fi
fi
[[ "$timestamp" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2})$ ]] || {
	echo "invalid CARBON_BUILD_TIMESTAMP: $timestamp" >&2
	exit 2
}

version="$(printf '%d.%d.%d%02d%02d' \
	"$((10#${BASH_REMATCH[1]:2:2}))" \
	"$((10#${BASH_REMATCH[2]}))" \
	"$((10#${BASH_REMATCH[3]}))" \
	"$((10#${BASH_REMATCH[4]}))" \
	"$((10#${BASH_REMATCH[5]}))")"
release_version_from_build "$version" >/dev/null || {
	echo "invalid Eastern build timestamp: $timestamp" >&2
	exit 2
}
printf '%s\n' "$version"
