#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
MODE="${1:-update}"

if [[ "${MODE}" != "update" && "${MODE}" != "--check" ]]; then
	echo "usage: ./scripts/update-reflection [--check]" >&2
	exit 2
fi

metadata="$(curl -fsSL https://clientsettingscdn.roblox.com/v2/client-version/WindowsStudio64/channel/LIVE)"
studio_version="$(jq -er '.version | select(test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"))' <<<"${metadata}")"
build_id="$(jq -er '.clientVersionUpload | select(test("^version-[0-9a-f]+$"))' <<<"${metadata}")"

cache_root="${XDG_CACHE_HOME:-${HOME}/.cache}/carbon/reflection/${build_id}-${studio_version}"
api_dump="${cache_root}/API-Dump.json"
mkdir -p -- "${cache_root}"

if [[ ! -s "${api_dump}" ]]; then
	temporary="${api_dump}.tmp.$$"
	trap 'rm -f -- "${temporary}"' EXIT
	curl -fsSL "https://setup.rbxcdn.com/${build_id}-API-Dump.json" -o "${temporary}"
	jq -e '.Classes | type == "array"' "${temporary}" >/dev/null
	mv -- "${temporary}" "${api_dump}"
	trap - EXIT
fi

(
	cd -- "${REPO}/studio-plugin"
	lune run scripts/update-reflection-database.luau "${api_dump}" "${studio_version}"
	lune run scripts/generate-database.luau
)

if [[ "${MODE}" == "--check" ]]; then
	if ! git -C "${REPO}" diff --quiet -- \
		studio-plugin/src/Lib/Dom/database.luau \
		studio-plugin/src/Lib/Dom/database.msgpack; then
		echo "generated reflection data is stale for Roblox Studio ${studio_version} (${build_id})" >&2
		git -C "${REPO}" diff --stat -- \
			studio-plugin/src/Lib/Dom/database.luau \
			studio-plugin/src/Lib/Dom/database.msgpack >&2
		exit 1
	fi
	echo "Verified reflection data for Roblox Studio ${studio_version} (${build_id})"
else
	echo "Updated reflection data for Roblox Studio ${studio_version} (${build_id})"
fi
