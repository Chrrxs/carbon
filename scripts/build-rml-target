#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${CARBON_RML_CMAKE_BUILD_DIR:-}" ]]; then
	echo "CARBON_RML_CMAKE_BUILD_DIR must name the existing persistent RML CMake build directory" >&2
	exit 2
fi
if [[ $# -ne 1 || ! "$1" =~ ^[A-Za-z0-9_.+-]+$ ]]; then
	echo "Usage: CARBON_RML_CMAKE_BUILD_DIR=<existing-dir> $0 <target>" >&2
	exit 2
fi

target="$1"
build_dir="$CARBON_RML_CMAKE_BUILD_DIR"

if [[ "$build_dir" =~ ^[A-Za-z]:[\\/] ]]; then
	windows_script="$(wslpath -w "${BASH_SOURCE[0]}.ps1")"
	powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$windows_script" -BuildDir "$build_dir" -Target "$target"
else
	if [[ ! -f "$build_dir/CMakeCache.txt" ]]; then
		echo "persistent RML CMake build directory is not configured: $build_dir" >&2
		exit 2
	fi
	cmake --build "$build_dir" --config Release --target "$target"
fi
