#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO="$(cd "${SCRIPT_DIR}/.." && pwd -P)"
# shellcheck source=scripts/lib/release-receipt.sh
. "${SCRIPT_DIR}/lib/release-receipt.sh"

if [[ -n "${CARBON_BUILD_IDENTITY:-}" ]]; then
	[[ "$CARBON_BUILD_IDENTITY" =~ ^0\.0\.0\+build\.[0-9a-f]{12}$ ]] || {
		echo "invalid CARBON_BUILD_IDENTITY: $CARBON_BUILD_IDENTITY" >&2
		exit 2
	}
	printf '%s\n' "$CARBON_BUILD_IDENTITY"
	exit 0
fi

product_paths=(
	Cargo.toml
	Cargo.lock
	cli
	studio-plugin
	qualification
	scripts
)

fingerprint="$(release_source_fingerprint "$REPO" "${product_paths[@]}")"
printf '0.0.0+build.%s\n' "${fingerprint:0:12}"
