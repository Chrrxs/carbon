#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
BUILD_SCRIPT="${SCRIPT_DIR}/build-rml.ps1"

failure=0

if ! grep -Fq -- '"-DRML_FORCE_INCLUDE_COMMON_WITHOUT_PCH=OFF"' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not enable PCH" >&2
	failure=1
fi

if ! grep -Fq -- '@("--build", $BuildDir, "--parallel", "--target", "roblox_modloader")' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not scope CMake to roblox_modloader" >&2
	failure=1
fi

if ! grep -Fq -- 'Microsoft Visual Studio\Installer\vswhere.exe' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not discover Visual Studio with vswhere" >&2
	failure=1
fi

if ! grep -Fq -- 'Get-Command cmake.exe' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not fall back to CMake on PATH" >&2
	failure=1
fi

if ! grep -Fq -- 'Get-Command ninja.exe' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not fall back to Ninja on PATH" >&2
	failure=1
fi
if ! grep -Fq -- 'carbon-studio-helper.cpp' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not compile carbon-studio-helper.cpp" >&2
	failure=1
fi

if ! grep -Fq -- '(Join-Path $stage "carbon-studio-helper.exe")' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not require carbon-studio-helper.exe" >&2
	failure=1
fi

HELPER_SOURCE="${SCRIPT_DIR}/carbon-studio-helper.cpp"

if ! grep -Fq -- 'Usage: carbon-studio-helper <launch|inject|terminate|focus> [args...]' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper usage does not mention focus command" >&2
	failure=1
fi

if ! grep -Fq -- 'Usage: carbon-studio-helper focus <pid> <filetime> <studio_b64> <restore_0_or_1>' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus usage is missing" >&2
	failure=1
fi

if ! grep -Fq -- 'cmd_focus' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper does not implement cmd_focus" >&2
	failure=1
fi

if ! grep -Fq -- 'paths_equal' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus does not validate studio image path" >&2
	failure=1
fi

if ! grep -Fq -- 'AttachThreadInput' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus does not attach foreground input queues" >&2
	failure=1
fi

if ! grep -Fq -- 'GetForegroundWindow' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus does not verify GetForegroundWindow" >&2
	failure=1
fi

if ! grep -Fq -- 'GetLastActivePopup' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus does not activate an owned modal window" >&2
	failure=1
fi

if ! grep -Fq -- 'restore_str != "0" && restore_str != "1"' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus does not validate the restore flag" >&2
	failure=1
fi

if ! grep -Fq -- 'if (IsIconic(target_hwnd))' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper must only restore minimized Studio windows" >&2
	failure=1
fi

PROXY_GENERATOR_SOURCE="${SCRIPT_DIR}/../rml/code/tools/proxy_generator/src/main.cpp"

if ! grep -Fq -- 'if (isolated_loader.empty()) return nullptr;' "$PROXY_GENERATOR_SOURCE"; then
	echo "FAIL: RML proxy must stay inactive outside Carbon-launched Studio" >&2
	failure=1
fi

if ! grep -Fq -- 'setup_function_pointers();' "$PROXY_GENERATOR_SOURCE"; then
	echo "FAIL: RML proxy must forward dwmapi exports without loading RML" >&2
	failure=1
fi

if grep -Fq -- 'current_path / \"RobloxModLoader\" / \"roblox_modloader.dll\"' "$PROXY_GENERATOR_SOURCE"; then
	echo "FAIL: RML proxy must not load Carbon RML during a normal Studio launch" >&2
	failure=1
fi

if grep -Fq -- 'FreeLibrary(mod_loader);' "$PROXY_GENERATOR_SOURCE"; then
	echo "FAIL: RML proxy must not unload an attestation failure from DllMain" >&2
	failure=1
fi

if ((failure != 0)); then
	exit "$failure"
fi

echo "PASS: RML package build is optimized and discovers hosted Windows tools portably"
