#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
BUILD_SCRIPT="${SCRIPT_DIR}/build-rml.ps1"

failure=0

if ! grep -Fq -- '"-DRML_FORCE_INCLUDE_COMMON_WITHOUT_PCH=OFF"' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not enable PCH" >&2
	failure=1
fi

if ! grep -Fq -- '@("--build", $BuildDir, "--parallel", "--target", "roblox_modloader")' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not scope CMake to roblox_modloader" >&2
	failure=1
fi
CONTRIBUTING="${SCRIPT_DIR}/../CONTRIBUTING.md"
TARGET_BUILDER="${SCRIPT_DIR}/build-rml-target"
TARGET_BUILDER_PS="${TARGET_BUILDER}.ps1"
if [[ ! -x "$TARGET_BUILDER" || ! -f "$TARGET_BUILDER_PS" ]]; then
	echo "FAIL: guarded incremental RML target builders are missing" >&2
	failure=1
fi

if grep -Eq -- '(^|[[:space:]])(-S|-B|--fresh|--clean-first)([[:space:]]|$)|New-PSDrive|subst[.]exe' \
	"$TARGET_BUILDER" "$TARGET_BUILDER_PS"; then
	echo "FAIL: incremental RML target builder reconfigures, cleans, or remaps the persistent build" >&2
	failure=1
fi

if ! grep -Fq -- 'CMAKE_HOME_DIRECTORY' "$TARGET_BUILDER_PS" ||
	! grep -Fq -- "expected Ninja" "$TARGET_BUILDER_PS" ||
	! grep -Fq -- "source mismatch" "$TARGET_BUILDER_PS" ||
	! grep -Fq -- '[IO.Path]::GetFullPath' "$TARGET_BUILDER_PS" ||
	! grep -Fq -- 'VsDevCmd.bat' "$TARGET_BUILDER_PS" ||
	! grep -Fq -- '$env:INCLUDE' "$TARGET_BUILDER_PS" ||
	! grep -Fq -- 'Resolve-CMake' "$TARGET_BUILDER_PS" ||
	! grep -Fq -- 'wslpath -w "$build_dir"' "$TARGET_BUILDER"; then
	echo "FAIL: incremental RML target builder does not normalize WSL paths, validate its Ninja cache, and initialize MSVC/CMake" >&2
	failure=1
fi

if ! grep -Fq -- 'ConvertTo-CanonicalWindowsPath' "$BUILD_SCRIPT" ||
	! grep -Fq -- 'Assert-CMakeCacheIdentity' "$BUILD_SCRIPT"; then
	echo "FAIL: RML configure entrypoint does not canonicalize Windows paths and guard cache identity" >&2
	failure=1
fi

if CARBON_RML_CMAKE_BUILD_DIR="${SCRIPT_DIR}/definitely-missing-cmake-build" \
	"$TARGET_BUILDER" roblox_modloader >/dev/null 2>&1; then
	echo "FAIL: incremental RML target builder accepted a directory without CMakeCache.txt" >&2
	failure=1
fi

if ! grep -Fq -- 'CARBON_RML_CMAKE_BUILD_DIR' "$CONTRIBUTING"; then
	echo "FAIL: contributor workflow does not define one persistent RML CMake build directory" >&2
	failure=1
fi

if ! grep -Fq -- 'cmake --build $env:CARBON_RML_CMAKE_BUILD_DIR --config Release --target <target>' "$CONTRIBUTING"; then
	echo "FAIL: contributor workflow does not require incremental target-only RML builds" >&2
	failure=1
fi

if ! grep -Fq -- 'Do not reconfigure, clean, remap, or replace that build directory' "$CONTRIBUTING"; then
	echo "FAIL: contributor workflow does not preserve the configured RML build cache" >&2
	failure=1
fi

if ! grep -Fq -- 'Run the clean package build only once' "$CONTRIBUTING"; then
	echo "FAIL: contributor workflow does not reserve clean packaging for final qualification" >&2
	failure=1
fi


if ! grep -Fq -- 'Microsoft Visual Studio\Installer\vswhere.exe' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not discover Visual Studio with vswhere" >&2
	failure=1
fi

if ! grep -Fq -- 'Get-Command cmake.exe' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not fall back to CMake on PATH" >&2
	failure=1
fi

if ! grep -Fq -- 'Get-Command ninja.exe' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not fall back to Ninja on PATH" >&2
	failure=1
fi
if ! grep -Fq -- 'carbon-studio-helper.cpp' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not compile carbon-studio-helper.cpp" >&2
	failure=1
fi

if ! grep -Fq -- '(Join-Path $stage "carbon-studio-helper.exe")' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not require carbon-studio-helper.exe" >&2
	failure=1
fi
if ! grep -Fq -- '[switch] $NativeOnly' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not define -NativeOnly switch" >&2
	failure=1
fi

if ! grep -Fq -- 'Validating cached .NET SDK in native-only mode' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not validate cached .NET SDK in native-only mode" >&2
	failure=1
fi

if ! grep -Fq -- 'cached managed artifact is missing in $BuildDir' "$BUILD_SCRIPT"; then
	echo "FAIL: RML package build does not validate cached managed outputs in native-only mode" >&2
	failure=1
fi

HELPER_SOURCE="${SCRIPT_DIR}/carbon-studio-helper.cpp"
if ! grep -Fq -- 'WaitForSingleObject(hThread.get(), 1000)' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper does not use the bounded opportunistic injector wait" >&2
	failure=1
fi

if ! grep -Fq -- 'if (waitResult == WAIT_TIMEOUT)' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper does not preserve the remote loader allocation after timeout" >&2
	failure=1
fi

if grep -Fq -- 'GetExitCodeThread(hThread.get(), &loadResult)' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper must use bridge attestation instead of blocking on LoadLibraryW" >&2
	failure=1
fi


if ! grep -Fq -- '<launch|inject|terminate|focus|bridge-request> [args...]' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper usage does not mention bridge-request command" >&2
	failure=1
fi

if ! grep -Fq -- 'Usage: carbon-studio-helper bridge-request <port> <method> ' "$HELPER_SOURCE" ||
	! grep -Fq -- '<path_b64> <content_type_or_dash> <range_or_dash> <timeout_ms>' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper bridge-request usage is missing" >&2
	failure=1
fi

if ! grep -Fq -- 'Usage: carbon-studio-helper focus <pid> <filetime> ' "$HELPER_SOURCE" ||
	! grep -Fq -- '<studio_b64> <restore_0_or_1>' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus usage is missing" >&2
	failure=1
fi

if ! grep -Fq -- 'cmd_focus' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper does not implement cmd_focus" >&2
	failure=1
fi

if ! grep -Fq -- 'paths_equal' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus does not validate studio image path" >&2
	failure=1
fi

if ! grep -Fq -- 'AttachThreadInput' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus does not attach foreground input queues" >&2
	failure=1
fi

if ! grep -Fq -- 'GetForegroundWindow' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus does not verify GetForegroundWindow" >&2
	failure=1
fi

if ! grep -Fq -- 'GetLastActivePopup' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus does not activate an owned modal window" >&2
	failure=1
fi

if ! grep -Fq -- 'restore_str != "0" && restore_str != "1"' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper focus does not validate the restore flag" >&2
	failure=1
fi

if ! grep -Fq -- 'if (IsIconic(target_hwnd))' "$HELPER_SOURCE"; then
	echo "FAIL: Carbon studio helper must only restore minimized Studio windows" >&2
	failure=1
fi

PROXY_GENERATOR_SOURCE="${SCRIPT_DIR}/../rml/code/tools/proxy_generator/src/main.cpp"

if ! grep -Fq -- 'if (isolated_loader.empty()) return nullptr;' "$PROXY_GENERATOR_SOURCE"; then
	echo "FAIL: RML proxy must stay inactive outside Carbon-launched Studio" >&2
	failure=1
fi

if ! grep -Fq -- 'setup_function_pointers();' "$PROXY_GENERATOR_SOURCE"; then
	echo "FAIL: RML proxy must forward dwmapi exports without loading RML" >&2
	failure=1
fi

if grep -Fq -- 'current_path / \"RobloxModLoader\" / \"roblox_modloader.dll\"' "$PROXY_GENERATOR_SOURCE"; then
	echo "FAIL: RML proxy must not load Carbon RML during a normal Studio launch" >&2
	failure=1
fi

if grep -Fq -- 'FreeLibrary(mod_loader);' "$PROXY_GENERATOR_SOURCE"; then
	echo "FAIL: RML proxy must not unload an attestation failure from DllMain" >&2
	failure=1
fi

if ((failure != 0)); then
	exit "$failure"
fi

echo "PASS: RML package build is optimized and discovers hosted Windows tools portably"
