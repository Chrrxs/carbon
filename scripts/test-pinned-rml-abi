#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
RML="${SCRIPT_DIR}/../rml/code/roblox_modloader"
POINTERS="${RML}/src/pointers.cpp"
CMAKE="${RML}/CMakeLists.txt"
PROFILE_HEADER="${RML}/include/RobloxModLoader/roblox/pinned_internals_profile.hpp"
PROFILE_SOURCE="${RML}/src/roblox/pinned_internals_profile.cpp"

fail() {
	echo "pinned-rml-abi: $*" >&2
	exit 1
}

[[ -f "$PROFILE_HEADER" ]] || fail "pinned ABI profile declaration is missing"
[[ -f "$PROFILE_SOURCE" ]] || fail "pinned ABI profile implementation is missing"

grep -Fq 'load_pinned_internals_profile' "$POINTERS" ||
	fail "RML does not load the pinned ABI profile"
if grep -Fq 'resolve_bootstrap' "$POINTERS"; then
	fail "RML still discovers its ABI inside the Studio process"
fi

grep -Fq 'verify_studio_identity' "$PROFILE_SOURCE" ||
	fail "pinned ABI profile does not verify the exact Studio image"
grep -Fq 'supported_studio_version' "$PROFILE_SOURCE" ||
	fail "pinned ABI profile does not identify its supported Studio release"
grep -Fq 'supported_studio_file_size' "$PROFILE_SOURCE" ||
	fail "pinned ABI profile does not verify the Studio executable size"
grep -Fq 'supported_studio_sha256' "$PROFILE_SOURCE" ||
	fail "pinned ABI profile does not verify the Studio executable digest"
grep -Fq 'waiting_scripts_job_data_model_accessor_rva' "$PROFILE_SOURCE" ||
	fail "pinned ABI profile does not relocate its function capability from an RVA"
grep -Fq 'target_link_libraries(roblox_modloader PRIVATE bcrypt)' "$CMAKE" ||
	fail "production loader is not linked to Windows SHA-256 verification"

grep -Fq 'list(FILTER MODLOADER_SUBDIRS EXCLUDE REGEX "/roblox/reflection/runtime_layout_resolver[.]cpp$")' "$CMAKE" ||
	fail "runtime reflection resolver is still linked into the production loader"
grep -Fq 'list(FILTER MODLOADER_SUBDIRS EXCLUDE REGEX "/roblox/datamodel_layout_resolver[.]cpp$")' "$CMAKE" ||
	fail "runtime DataModel resolver is still linked into the production loader"
grep -Fq 'list(FILTER MODLOADER_SUBDIRS EXCLUDE REGEX "/roblox/internals_profile[.]cpp$")' "$CMAKE" ||
	fail "runtime profile resolver is still linked into the production loader"
if grep -Rq '\[DEBUG-' "$RML/src"; then
	fail "temporary ABI discovery logging remains in production source"
fi

echo "PASS: RML uses an exact version-pinned ABI profile and keeps discovery offline"
