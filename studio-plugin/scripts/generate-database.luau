--!strict

local fs = require("@lune/fs")
local process = require("@lune/process")

local MsgPack = require("../src/Lib/MsgPack")

local INPUT = "src/Lib/Dom/database.msgpack"
local OUTPUT = "src/Lib/Dom/database.luau"
local HEADER = "--!native\n-- Generated by scripts/generate-database.luau; do not edit.\n-- stylua: ignore\nreturn "

local function isArray(value: { [any]: any }): (boolean, number)
	local length = #value
	local count = 0
	for key in value do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > length then
			return false, 0
		end
		count += 1
	end
	return count == length, length
end

local function writeValue(chunks: { string }, value: any)
	local kind = type(value)
	if kind == "nil" then
		table.insert(chunks, "nil")
	elseif kind == "boolean" then
		table.insert(chunks, value and "true" or "false")
	elseif kind == "number" then
		if value ~= value then
			table.insert(chunks, "(0/0)")
		elseif value == math.huge then
			table.insert(chunks, "math.huge")
		elseif value == -math.huge then
			table.insert(chunks, "-math.huge")
		else
			table.insert(chunks, tostring(value))
		end
	elseif kind == "string" then
		table.insert(chunks, string.format("%q", value))
	elseif kind == "table" then
		local array, length = isArray(value)
		table.insert(chunks, "{")
		if array then
			for index = 1, length do
				if index > 1 then
					table.insert(chunks, ",")
				end
				writeValue(chunks, value[index])
			end
		else
			local entries = {}
			for key, entryValue in value do
				local keyChunks = {}
				writeValue(keyChunks, key)
				table.insert(entries, {
					key = table.concat(keyChunks),
					value = entryValue,
				})
			end
			table.sort(entries, function(a, b)
				return a.key < b.key
			end)
			for index, entry in entries do
				if index > 1 then
					table.insert(chunks, ",")
				end
				table.insert(chunks, "[")
				table.insert(chunks, entry.key)
				table.insert(chunks, "]=")
				writeValue(chunks, entry.value)
			end
		end
		table.insert(chunks, "}")
	else
		error(`Unsupported MessagePack value type: {kind}`)
	end
end

local decoded = MsgPack.decode(fs.readFile(INPUT))
local chunks = { HEADER }
writeValue(chunks, decoded)
table.insert(chunks, "\n")
local generated = table.concat(chunks)

if table.find(process.args, "--check") then
	if not fs.isFile(OUTPUT) or fs.readFile(OUTPUT) ~= generated then
		error(`{OUTPUT} is stale; run: lune run scripts/generate-database.luau`)
	end
	print(`Verified {OUTPUT}`)
else
	fs.writeFile(OUTPUT, generated)
	print(`Generated {OUTPUT} ({#generated} bytes)`)
end
