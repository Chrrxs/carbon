<Project>
  <PropertyGroup>
    <CarbonBuildVersion Condition="'$(CARBON_BUILD_VERSION)' != ''">$(CARBON_BUILD_VERSION)</CarbonBuildVersion>
    <CarbonBuildVersion Condition="'$(CarbonBuildVersion)' == ''">0.0.0+local</CarbonBuildVersion>
    <Version>$(CarbonBuildVersion)</Version>
    <InformationalVersion>$(CarbonBuildVersion)</InformationalVersion>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
  </PropertyGroup>
</Project>
