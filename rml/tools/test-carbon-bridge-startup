#!/usr/bin/env bash
set -euo pipefail

PLACE=${1:?usage: tools/test-carbon-bridge-startup <place.rbxl>}

windows_local_app_data=$(powershell.exe -NoProfile -Command '[Environment]::GetFolderPath("LocalApplicationData")' | tr -d '\r')
local_app_data=$(wslpath -u "$windows_local_app_data")

if [[ -n ${ROBLOX_STUDIO_EXE:-} ]]; then
	STUDIO_EXE=$ROBLOX_STUDIO_EXE
else
	windows_studio_exe=$(powershell.exe -NoProfile -Command '
    Get-ChildItem "$env:LOCALAPPDATA/Roblox/Versions/*/RobloxStudioBeta.exe" -ErrorAction SilentlyContinue |
      Sort-Object LastWriteTime -Descending |
      Select-Object -First 1 -ExpandProperty FullName
  ' | tr -d '\r')
	STUDIO_EXE=$(wslpath -u "$windows_studio_exe")
fi

studio_dir=$(dirname "$STUDIO_EXE")
if [[ -z "${RML_LOG:-}" ]]; then
	rml_root="${CARBON_RML_PACKAGE:-$studio_dir}"
	RML_LOG="${rml_root}/RobloxModLoader/logs/roblox_modloader_$(date +%F).log"
fi
REGISTRY=${CARBON_RML_BRIDGE_REGISTRY:-$local_app_data/RobloxModLoader/carbon-bridges/v1}

if [[ ! -f "$PLACE" || ! -f "$STUDIO_EXE" ]]; then
	echo "place or Studio executable is missing" >&2
	exit 2
fi

before=$(rg -c '=== \[VEH\] CRITICAL EXCEPTION DETECTED' "$RML_LOG" 2>/dev/null || true)
declare -A existing_records=()
while IFS= read -r record; do
	existing_records["$record"]=1
done < <(find "$REGISTRY" -maxdepth 1 -type f -name '*.json' -printf '%f\n' 2>/dev/null || true)
CARBON_TEST_STUDIO_EXE=$(wslpath -w "$STUDIO_EXE")
CARBON_TEST_PLACE=$(wslpath -w "$PLACE")
if [[ "$CARBON_TEST_STUDIO_EXE$CARBON_TEST_PLACE" == *"'"* ]]; then
	echo "paths containing apostrophes are unsupported by this test harness" >&2
	exit 2
fi

pid=$(powershell.exe -NoProfile -Command "
  \$process = Start-Process -FilePath '$CARBON_TEST_STUDIO_EXE' \`
    -ArgumentList '--task', 'EditFile', '--localPlaceFile', '$CARBON_TEST_PLACE' \`
    -PassThru
  \$process.Id
" | tr -d '\r')
new_record=

cleanup() {
	powershell.exe -NoProfile -Command "
    Stop-Process -Id $pid -Force -ErrorAction SilentlyContinue
  " >/dev/null 2>&1 || true
	if [[ -n "$new_record" ]]; then
		rm -f "$REGISTRY/$new_record"
	fi
}
trap cleanup EXIT

for _ in $(seq 1 60); do
	after=$(rg -c '=== \[VEH\] CRITICAL EXCEPTION DETECTED' "$RML_LOG" 2>/dev/null || true)
	if (( after > before )); then
		echo "FAIL: Studio process $pid triggered an RML critical exception" >&2
		exit 1
	fi

	alive=$(powershell.exe -NoProfile -Command "(Get-Process -Id $pid -ErrorAction SilentlyContinue).Id" | tr -d '\r')
	if [[ -z "$alive" ]]; then
		echo "FAIL: launched Studio process $pid exited during RML startup" >&2
		exit 1
	fi

	new_record=
	while IFS= read -r record; do
		if [[ -n ${existing_records["$record"]:-} ]]; then
			continue
		fi
		if jq -e --argjson pid "$pid" '.processId == $pid' "$REGISTRY/$record" >/dev/null 2>&1; then
			new_record=$record
			break
		fi
	done < <(find "$REGISTRY" -maxdepth 1 -type f -name '*.json' -printf '%f\n' 2>/dev/null || true)
	if [[ -n "$new_record" ]]; then
		endpoint=$(jq -r '.endpoint' "$REGISTRY/$new_record")
		token=$(jq -r '.token' "$REGISTRY/$new_record")
		if ! diagnostic=$(CARBON_TEST_ENDPOINT="${endpoint%/}/v1/diagnostics/rejected-yield" \
			CARBON_TEST_TOKEN="$token" \
			powershell.exe -NoProfile -Command '
				$headers = @{ Authorization = "Bearer $env:CARBON_TEST_TOKEN" }
				(Invoke-WebRequest -UseBasicParsing -Method Post `
					-Uri $env:CARBON_TEST_ENDPOINT -Headers $headers -TimeoutSec 15).Content
			' | tr -d '\r'); then
			echo "FAIL: rejected-yield diagnostic did not answer within 15 seconds" >&2
			exit 1
		fi
		if ! jq -e '.rejected == true' <<<"$diagnostic" >/dev/null; then
			echo "FAIL: rejected-yield diagnostic did not observe an engine rejection: $diagnostic" >&2
			exit 1
		fi
		# The old callback dereferenced the opaque engine error and crashed before
		# the managed rejection could return. Also leave time for deferred VEH logs.
		sleep 3
		after=$(rg -c '=== \[VEH\] CRITICAL EXCEPTION DETECTED' "$RML_LOG" 2>/dev/null || true)
		if (( after > before )); then
			echo "FAIL: Studio process $pid triggered an RML critical exception" >&2
			exit 1
		fi
		echo "PASS: Studio process $pid survived startup and a deliberately rejected reflected yield"
		exit 0
	fi

	sleep 0.25
done

echo "FAIL: Studio process $pid did not publish an RML bridge record" >&2
exit 1
