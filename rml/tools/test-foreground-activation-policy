#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
RML_DIR="$(cd "${SCRIPT_DIR}/.." && pwd -P)"
BUILD_DIR="$(mktemp -d /tmp/carbon-foreground-policy-XXXXXX)"
trap 'rm -rf -- "$BUILD_DIR"' EXIT

"${CXX:-c++}" \
	-std=c++23 \
	-Wall \
	-Wextra \
	-Werror \
	-I"${RML_DIR}/code/roblox_modloader/src" \
	"${RML_DIR}/code/roblox_modloader/tests/foreground_activation_policy_tests.cpp" \
	-o "${BUILD_DIR}/foreground_activation_policy_tests"

"${BUILD_DIR}/foreground_activation_policy_tests"
